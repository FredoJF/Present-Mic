DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DATABASE_URL="file:./dev.db"
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
# Required by LavaSrc to resolve Spotify URLs and playlists. Create these in
# the Spotify Developer Dashboard; do not commit the values.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional Spotify account cookie used for LavaLyrics. It is not enough to
# resolve Spotify-generated playlists by itself.
SPOTIFY_SP_DC=
# Required by LavaSrc for direct Deezer playback.
DEEZER_ARL=
# Required by LavaSrc to decrypt Deezer tracks.
DEEZER_MASTER_DECRYPTION_KEY=
LOG_LEVEL=info
